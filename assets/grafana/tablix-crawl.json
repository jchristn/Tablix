      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(tablix_crawl_cache_lookups_total{result=\"hit\"}[$__rate_interval])) / clamp_min(sum(rate(tablix_crawl_cache_lookups_total[$__rate_interval])), 1e-9)",
          "legendFormat": "hit ratio"
