        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, source) (rate(tablix_query_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{source}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, source) (rate(tablix_query_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 {{source}}"
        }
      ]
    },
